# Discord Developer Portal → your application → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot tab → Reset Token. Only used to register the slash commands.
DISCORD_BOT_TOKEN=
# Optional: register commands to one server for instant updates while testing.
DISCORD_GUILD_ID=
# Any long random string; lets you register commands by visiting /api/register?key=...
REGISTER_KEY=

# Supabase → Project Settings → API. Without these, data is kept in memory only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the AI Dungeon Master. Claude (billed per use by Anthropic) is used
# when its key is set; otherwise a free Groq key works (rate-limited, less reliable).
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# DM_PROVIDER=auto   # or "anthropic" / "groq" to force one
# Optional overrides
DM_MODEL=claude-opus-5-5
DM_EFFORT=medium
