# Discord Developer Portal → your application → General Information
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Bot tab → Reset Token. Only needed to register commands (npm run register).
DISCORD_BOT_TOKEN=
# Optional: register commands to one server for instant updates while testing.
DISCORD_GUILD_ID=

# Supabase → Project Settings → API. Without these, data is kept in memory only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the AI Dungeon Master (billed per use by Anthropic).
ANTHROPIC_API_KEY=
# Optional overrides
DM_MODEL=claude-opus-5-5
DM_EFFORT=medium
